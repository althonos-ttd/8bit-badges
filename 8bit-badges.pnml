// define the newgrf
grf {
	grfid:	"8BBS";
	name:	string(STR_GRF_NAME);
	desc:	string(STR_GRF_DESCRIPTION);
	url:    string(STR_GRF_URL);
	version:		REPO_REVISION;
	min_compatible_version:	6630;
}

item (FEAT_BADGES, flag) {
    property {
        label: "flag";
        name:  string(STR_CLASS_FLAG);
    }
}

// --- Flag - ISO 3611 Flags ---

#define FLAG(id) \
    spriteset(sprite_flag_ ## id, format_string("gfx/flag/%s.xpm", #id)) { \
        [0, 0] \
    } \
    item (FEAT_BADGES, flag_ ## id) {              \
        property {                                 \
            label: format_string("flag/%s", #id);  \
            name:  string(STR_FLAG_ ## id);        \
        }                                          \
        graphics {                                 \
            default: sprite_flag_ ## id ;          \
        }                                          \
    }

