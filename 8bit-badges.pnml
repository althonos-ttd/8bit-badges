// --- Flag - European Union ---

spriteset(sprite_flag_europe, "gfx/flag/europe.xpm") {
    [0, 0]
}

item (FEAT_BADGES, flag_europe) {
    property {
        label: "flag/europe";
        name:  string(STR_FLAG_EUROPE);
    }
    graphics {
        default: sprite_flag_europe;
    }
}

// --- Power / Propulsion ---

item (FEAT_BADGES, power) {
    property {
        label: "power";
        name:  string(STR_CLASS_POWER);
    }
}

#define POWER(id, path) \
    spriteset(sprite_power_ ## id, format_string("gfx/power/%s.xpm", path)) { \
        [0, 0] \
    } \
    item (FEAT_BADGES, power_ ## id) {              \
        property {                                  \
            label: format_string("power/%s", path); \
            name:  string(STR_POWER_ ## id);        \
        }                                           \
        graphics {                                  \
            default: sprite_power_ ## id ;          \
        }                                           \
    }

// POWER(battery, "battery")
POWER(diesel, "diesel")
POWER(dual, "dual")
POWER(gasoline, "gasoline")
POWER(electric, "electric")
POWER(electric_ac, "electric/ac")
POWER(electric_dc, "electric/dc")
// POWER(hydrogen, "hydrogen")
POWER(steam, "steam")
POWER(turbine, "turbine")

// --- Attribute ---

item (FEAT_BADGES, attribute) {
    property {
        label: "attribute";
        name:  string(STR_CLASS_ATTRIBUTE);
    }
}

#define ATTRIBUTE(id, path) \
    spriteset(sprite_attribute_ ## id, format_string("gfx/attribute/%s.xpm", path)) { \
        [0, 0] \
    } \
    item (FEAT_BADGES, power_ ## id) {              \
        property {                                  \
            label: format_string("attribute/%s", path); \
            name:  string(STR_ATTRIBUTE_ ## id);        \
        }                                           \
        graphics {                                  \
            default: sprite_attribute_ ## id ;          \
        }                                           \
    }

ATTRIBUTE(push_pull, "push_pull")
ATTRIBUTE(concept, "concept")